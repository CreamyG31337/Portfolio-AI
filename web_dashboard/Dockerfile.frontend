# Shared Frontend Builder for Tailwind CSS and TypeScript
# Built once, used by both Streamlit and Flask containers

FROM node:20-alpine
WORKDIR /app

# Copy package files for dependency installation
COPY package.json ./
COPY postcss.config.mjs ./
COPY tailwind.config.js ./
COPY web_dashboard/package.json ./web_dashboard/package.json
COPY web_dashboard/tsconfig.json ./web_dashboard/tsconfig.json

# Install root npm dependencies (Tailwind)
RUN --mount=type=cache,target=/root/.npm npm install

# Install web_dashboard npm dependencies (TypeScript)
WORKDIR /app/web_dashboard
RUN --mount=type=cache,target=/root/.npm npm install

# Copy source files
WORKDIR /app
COPY web_dashboard/static/css/input.css ./web_dashboard/static/css/input.css
COPY web_dashboard/templates ./web_dashboard/templates
COPY web_dashboard/src ./web_dashboard/src

# Build Tailwind CSS and TypeScript
RUN mkdir -p web_dashboard/static/css web_dashboard/static/js && \
    npm run build:css && \
    npm run build:ts && \
    test -f web_dashboard/static/css/tailwind.css && \
    test -f web_dashboard/static/js/dashboard.js
