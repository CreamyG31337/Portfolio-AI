# Caddyfile Example (Flask dashboard)
# Copy this to Caddyfile and set APP_DOMAIN environment variable
# Example: export APP_DOMAIN=your-domain.com
#
# Prerequisites on the host:
#   - trading-dashboard-flask container listening on localhost:5001
#   - Static auth pages deployed to /ai-trading/frontend (Woodpecker copies these)
#   - Optional: Research PDFs at /ai-trading/research
#   - Optional: App logs mounted at /srv/logs for /logs/* browsing

{$APP_DOMAIN} {
    # Optional: bind to specific interface
    # bind 192.168.100.69

    # Serve auth callback HTML (handles magic links & password resets)
    handle /auth_callback.html {
        root * /ai-trading/frontend
        file_server
    }

    # Serve set_cookie.html (sets auth cookie and redirects back)
    handle /set_cookie.html {
        root * /ai-trading/frontend
        file_server
    }

    # Serve login.html (simple HTML login form for browser automation)
    handle /login.html {
        root * /ai-trading/frontend
        file_server
    }

    # Serve Research PDF files (static file server)
    handle_path /research/* {
        root * /ai-trading/research
        file_server browse
        header Cache-Control "public, max-age=3600"
    }

    # API endpoints — Flask (trading-dashboard-flask on port 5001)
    handle /api/* {
        reverse_proxy localhost:5001 {
            trusted_proxies private_ranges
            trusted_proxies 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
        }
    }

    # Flask static assets (Vite/Tailwind build output)
    handle /assets/* {
        reverse_proxy localhost:5001 {
            trusted_proxies private_ranges
            trusted_proxies 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
        }
    }

    # Standard Flask static path
    handle /static/* {
        reverse_proxy localhost:5001 {
            trusted_proxies private_ranges
        }
    }

    # Serve logs directory (for AI / admin access)
    # Requires mounting host logs to /srv/logs in Caddy container
    handle_path /logs/* {
        root * /srv/logs
        file_server browse
    }

    # Everything else — Flask dashboard (default)
    reverse_proxy localhost:5001 {
        trusted_proxies private_ranges
        trusted_proxies 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
    }
}
